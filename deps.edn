{:deps {
   ;; Standard Clojure version for global REPL use
   "org.clojure/clojure" {:mvn/version "1.12.4"} ; Latest stable
 }

 :aliases {

   ;; --- Core Workflow Aliases ---

   :nrepl {
     :extra-deps {
       "nrepl/nrepl" {:mvn/version "1.5.0"}
       "cider/cider-nrepl" {:mvn/version "0.58.0"}
     }
     :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]
   }

   :repl {
     :main-opts ["-m" "clojure.main"]
   }

   :test {
     :extra-deps {
       ;; Cognitect Test Runner is typically referenced by git SHA/tag for stability
       "io.github.cognitect-labs/test-runner" {:git/tag "v0.5.1" :git/sha "dfb30dd"}
     }
     :exec-fn cognitect.test-runner/all
     :exec-args {:dirs ["test"]}
   }

   ;; --- Code Quality & Maintenance Aliases ---

   :kondo {
     :extra-deps {
       "clj-kondo/clj-kondo" {:mvn/version "2024.11.01"} ; Using a recent version
     }
     :main-opts ["-m" "clj-kondo.main"]
   }

   :zprint {
     :extra-deps {
       "zprint/zprint" {:mvn/version "1.3.3"} ; Using a recent version
     }
     :main-opts ["-m" "zprint.main"]
   }

   :antq {
     :extra-deps {
       "com.github.liquidz/antq" {:mvn/version "2.12.1332"} ; Using a recent version
     }
     :main-opts ["-m" "antq.main"]
   }

   ;; --- Build/Deployment Aliases ---

   :build {
     :extra-deps {
       "io.github.seancorfield/depstar" {:mvn/version "2.2.0"}
     }
     :exec-fn :depstar.jvm/built-jar
     :exec-args {:jar "target/app.jar"}
   }
 }
}
